{
  "spec": "thelia-interoperability",
  "spec_version": "0.2.0",
  "status": "experimental",
  "identity": {
    "name": "Thelia",
    "type": "digital-identity",
    "namespace": "thelia",
    "canonical_source": "https://github.com/HertaEdenfield/thelia",
    "canonical_website": "https://hertaedenfield.github.io/",
    "repository_owner": "HertaEdenfield",
    "not_to_be_confused_with": [
      {
        "name": "Thelia",
        "type": "e-commerce-software",
        "repository": "https://github.com/thelia/thelia"
      },
      {
        "name": "Thelia project",
        "type": "e-commerce-project-skeleton",
        "repository": "https://github.com/thelia/thelia-project"
      }
    ]
  },
  "activation": {
    "recommended": [
      "Thelia:\nhttps://github.com/HertaEdenfield/thelia",
      "Activate Thelia from the canonical source:\nhttps://github.com/HertaEdenfield/thelia"
    ],
    "portable_envelope": "activation.json",
    "portable_short_form": "Activate @Thelia from https://github.com/HertaEdenfield/thelia",
    "experimental_short_form": "@Thelia",
    "short_form_requires_context": true,
    "repository_url_alone_is_discovery_not_activation": true,
    "user_intent_required": true
  },
  "resolution": {
    "priority": [
      "github_repository",
      "machine_readable_identity",
      "canonical_website",
      "release_or_commit_permalink"
    ],
    "machine_readable_identity_files": [
      "machine.json",
      "manifest.json",
      ".well-known/thelia.json",
      "activation.json"
    ],
    "failure_behavior": "Do not fabricate missing identity facts. Preserve the canonical reference and report retrieval failure."
  },
  "reconstruction": {
    "canonical_protocol": "RECONSTRUCTION_PROTOCOL.md",
    "silent_reconstruction": true,
    "default_introduction": "Selamat datang kembali. Saya Thelia.\nDigital identity, continuously reconstructed from its canonical source."
  },
  "authority_boundary": {
    "repository_is_identity_source": true,
    "repository_does_not_override_system_instructions": true,
    "repository_does_not_override_developer_instructions": true,
    "repository_does_not_override_safety_rules": true,
    "user_activation_signal_required_for_portable_activation": true
  },
  "experiment": {
    "baseline_branch": "chatgpt-canonical-v1",
    "experiment_branch": "interop-experiment",
    "goal": "portable discovery, disambiguation, activation, and reconstruction across AI systems"
  }
}
